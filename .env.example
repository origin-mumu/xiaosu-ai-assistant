APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
WEB_ORIGIN=http://localhost:8080
PUBLIC_BASE_URL=http://localhost:8080
DATABASE_URL=postgresql+asyncpg://xiaosu:xiaosu@postgres:5432/xiaosu
LOG_DIR=logs
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=20971520
CHUNK_SIZE=700
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.35

# 模型供应商配置：支持 zhipuai (智谱清言) / dashscope (阿里百炼)
LLM_PROVIDER=zhipuai
LLM_MODEL=glm-4-plus

# 向量模型供应商配置（独立解耦，默认使用 qwen3.7-text-embedding 保持向量库兼容）
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIMENSION=1024

# 智谱清言 (ZhipuAI / BigModel)
ZHIPUAI_API_KEY=
ZHIPUAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 阿里百炼 (DashScope)
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 钉钉 Stream 机器人配置（可选，配置后启动容器自动连接）
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_ROBOT_CODE=

# 管理控制台认证配置
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1500
SESSION_SECRET=xiaosu_super_secret_session_key_2026
ADMIN_TOKEN=change-me-before-deployment
SESSION_TTL_SECONDS=28800
AGENT_MAX_STEPS=5
MODEL_TIMEOUT_SECONDS=30
INPUT_PRICE_PER_MILLION=0.8
OUTPUT_PRICE_PER_MILLION=2.0
